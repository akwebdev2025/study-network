rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users can create only their own profile, as student/teacher, pending.
    // Only admins can change role/status (verification, suspension, admin grants).
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['student', 'teacher']
        && request.resource.data.status == 'pending_verification';
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /studentProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /teacherProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Guarantees one account per academic identity (create-only, no overwrite).
    match /academicIdentities/{key} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /universities/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /colleges/{id}     { allow read: if signedIn(); allow write: if isAdmin(); }
    match /courses/{id}      { allow read: if signedIn(); allow write: if isAdmin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
